# Postgres connection string (local Docker default below; Neon must include ?sslmode=require)
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5433/seo_builder
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO=https://github.com/AliWarraich33621013/SEO_Builder

# One-time production DB setup (run locally against Neon DATABASE_URI):
#   pnpm db:setup
#   pnpm seed          # optional demo content
#   pnpm reset:admin   # create admin user
# Do not commit .env. Do not run migrate:fresh / migrate:reset on production.

# AI provider (gemini recommended default)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
